{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "./mvnw clean package -DskipTests"
    },
    "deploy": {
        "startCommand": "export MALLOC_ARENA_MAX=2 && java -Xmx128m -Xss256k -XX:-TieredCompilation -XX:CICompilerCount=1 -XX:ReservedCodeCacheSize=20m -XX:MaxMetaspaceSize=72m -XX:CompressedClassSpaceSize=24m -XX:+UseSerialGC -noverify -Xrs -Dcom.sun.management.jmxremote=false -Djava.security.egd=file:/dev/./urandom -jar target/recruitsmart-crm-0.0.1-SNAPSHOT.jar",
        "healthcheckPath": "/actuator/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}