{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "export MAVEN_OPTS='-Xmx128m -XX:+UseSerialGC -Dmaven.test.skip=true' && cd backend && ./mvnw clean package -DskipTests"
    },
    "deploy": {
        "startCommand": "java -Xmx320m -Xms192m -Xss512k -XX:TieredStopAtLevel=1 -XX:CICompilerCount=1 -XX:+UseSerialGC -Dserver.port=$PORT -Djava.security.egd=file:/dev/./urandom -jar backend/target/recruitsmart-crm-0.0.1-SNAPSHOT.jar",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 600,
        "restartPolicyType": "ALWAYS",
        "restartPolicyMaxRetries": 10
    }
}